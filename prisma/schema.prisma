datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String
  password          String?
  ssoId             String?   @unique
  createdAt         DateTime  @default(now())
  verificationToken String?
  isActive          Boolean?
  setupTokenExpires BigInt?
  sessions          Session[]
  createdProjects   Project[] @relation("ProjectCreatedBy")
  reportedTasks     Task[] @relation("TaskReporter")
  assignedTasks     Task[] @relation("TaskAssignee")
  modifiedProjects  Project[] @relation("ProjectModifiedBy")
  uploadedFiles     File[] @relation("FileUploader")
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  refreshToken String
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiredAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model Project {
  tasks             Task[]
  files             File[]
  id                Int      @id @default(autoincrement())
  name              String
  projectCode       String   @unique
  location          String
  status            String   @default("PLANNING")
  progress          Int      @default(0)
  budget            Decimal  @default(0) @db.Decimal(18, 2)
  expectedPersonnel Int      @default(1)
  imageUrl          String?  @db.Text
  description       String?
  participantIds    Json     @default("[]")
  managerIds        Json     @default("[]")
  createdBy         Int
  modifiedBy        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           User     @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  modifier          User?    @relation("ProjectModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  isDelete          Boolean  @default(false)

  @@index([createdBy])
  @@index([modifiedBy])
}

enum TaskType {
  TASK
  STORY
  BUG
  EPIC
  SUBTASK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

model File {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(255)
  projectId    Int?
  taskId       Int?
  fileName     String   @db.VarChar(191)
  originalName String?  @db.VarChar(191)
  mimeType     String?  @db.VarChar(191)
  size         Float    @default(0)
  url          String?  @db.Text
  description  String?  @db.Text
  uploadedBy   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploader     User     @relation("FileUploader", fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@index([uploadedBy])
}

model Task {
  id           Int @id @default(autoincrement())
  key          String @unique @db.VarChar(255)
  projectId    Int
  summary      String
  description  String @db.Text
  type         TaskType @default(TASK)
  status       TaskStatus @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  assigneeId   Int?
  reporterId   Int
  parentTaskId Int?
  labels       Json @default("[]")
  dueDate      DateTime?
  storyPoints  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  files        File[]
  project      Project @relation(fields: [projectId], references: [id])
  reporter     User @relation("TaskReporter", fields: [reporterId], references: [id])
  assignee     User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent       Task? @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children     Task[] @relation("TaskChildren")

  @@index([projectId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([parentTaskId])
}
