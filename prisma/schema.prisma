datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String
  password          String?
  ssoId             String?   @unique
  createdAt         DateTime  @default(now())
  verificationToken String?
  isActive          Boolean?
  setupTokenExpires BigInt?
  sessions          Session[]
  createdProjects   Project[] @relation("ProjectCreatedBy")
  modifiedProjects  Project[] @relation("ProjectModifiedBy")
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  refreshToken String
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiredAt    DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model Project {
  id                Int      @id @default(autoincrement())
  name              String
  projectCode       String   @unique
  location          String
  status            String   @default("PLANNING")
  progress          Int      @default(0)
  budget            Decimal  @default(0) @db.Decimal(18, 2)
  expectedPersonnel Int      @default(1)
  imageUrl          String?  @db.Text
  description       String?
  participantIds    Json     @default("[]")
  managerIds        Json     @default("[]")
  createdBy         Int
  modifiedBy        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creator           User     @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  modifier          User?    @relation("ProjectModifiedBy", fields: [modifiedBy], references: [id], onDelete: SetNull)
  isDelete          Boolean  @default(false)

  @@index([createdBy])
  @@index([modifiedBy])
}
